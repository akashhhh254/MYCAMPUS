rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPrincipal() {
      return isAuthenticated() && getUserRole() == 'principal';
    }

    function isTeacher() {
      return isAuthenticated() && (getUserRole() == 'teacher' || getUserRole() == 'principal');
    }

    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read basic directory profile
      // Principal can read all profiles; Students & Teachers can read their own
      allow read: if isAuthenticated();

      // Users can only create their initial profile document matching their Auth UID
      // Role field cannot be self-elevated to principal or teacher
      allow create: if isUser(userId) && (
        request.resource.data.role == 'student' || isPrincipal()
      );

      // Users can update their personal fields (name, mobile, avatar)
      // Only Principal can change user role or active status
      allow update: if isUser(userId) && (
        request.resource.data.role == resource.data.role || isPrincipal()
      );

      // Only Principal can delete user records
      allow delete: if isPrincipal();
    }

    // ==========================================
    // 2. Attendance Records
    // ==========================================
    match /attendance/{attendanceId} {
      // Students can read their own records; Teachers & Principal can read all
      allow read: if isAuthenticated();
      // Teachers and Principal can record and modify attendance
      allow create, update: if isTeacher();
      allow delete: if isPrincipal();
    }

    // ==========================================
    // 3. Timetable & Classes
    // ==========================================
    match /timetable/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isPrincipal();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    // ==========================================
    // 4. Study Materials & Assignments
    // ==========================================
    match /study_materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isPrincipal();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isPrincipal();
    }

    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTeacher() || isPrincipal();
    }

    // ==========================================
    // 5. Notices & Events
    // ==========================================
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isPrincipal();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isPrincipal();
    }

    // ==========================================
    // 6. CampusConnect Social & Study Groups
    // ==========================================
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isUser(resource.data.userId) || isPrincipal();
    }

    match /study_groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}
